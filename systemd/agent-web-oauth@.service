[Unit]
Description=Open an OpenAI OAuth page in Agent Web Chromium
Requires=agent-web-browser.service
After=agent-web-browser.service
JoinsNamespaceOf=agent-web-browser.service

[Service]
Type=oneshot
User=agent-web
Group=agent-web
Environment=HOME=/var/lib/agent-web
Environment=DISPLAY=:1
Environment=XAUTHORITY=/run/agent-web/Xauthority
Environment=XDG_RUNTIME_DIR=/run/agent-web/xdg
ExecStart=/usr/local/lib/agent-web/open-openai-oauth
StandardInput=socket
StandardOutput=socket
StandardError=journal
TimeoutStartSec=20
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
ReadWritePaths=/var/lib/agent-web /var/cache/agent-web/chromium /run/agent-web
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
