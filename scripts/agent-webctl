#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

config_file=$HOME/.config/agent-web/env
state_dir=$HOME/.local/share/agent-web/data/state
service_name=agent-web.service

if [[ -r "$config_file" ]]; then
    # shellcheck disable=SC1090
    source "$config_file"
else
    echo "Agent Web is not installed for this user." >&2
    exit 69
fi

access_url() {
    if [[ -n "${AGENT_WEB_HOST_IP:-}" ]]; then
        printf 'https://%s:6901/\n' "$AGENT_WEB_HOST_IP"
    else
        printf 'https://%s:6901/\n' "${AGENT_WEB_HOSTNAME:-agent-web}"
    fi
}

wait_until_ready() {
    local http_code
    for _ in $(seq 1 60); do
        http_code=$(curl -sk -o /dev/null -w '%{http_code}' https://127.0.0.1:6901/ || true)
        if [[ "$http_code" == 401 && ! -e "$state_dir/password.init" ]]; then
            return 0
        fi
        sleep 1
    done
    return 1
}

set_password() {
    if [[ ! -r /dev/tty || ! -w /dev/tty ]]; then
        echo "A terminal is required to change the password." >&2
        exit 74
    fi

    local first_password second_password
    while true; do
        read -r -s -p "New web password (at least 12 characters): " first_password </dev/tty
        printf '\n' >/dev/tty
        read -r -s -p "Confirm web password: " second_password </dev/tty
        printf '\n' >/dev/tty

        if [[ "${#first_password}" -lt 12 ]]; then
            echo "The password must contain at least 12 characters." >/dev/tty
        elif [[ "$first_password" != "$second_password" ]]; then
            echo "The passwords do not match." >/dev/tty
        elif [[ "$first_password" == *$'\n'* || "$first_password" == *$'\r'* ]]; then
            echo "The password cannot contain a newline." >/dev/tty
        else
            break
        fi
    done

    systemctl --user stop "$service_name"
    rm -f "$state_dir/htpasswd"
    printf '%s\n' "$first_password" >"$state_dir/password.init"
    chmod 600 "$state_dir/password.init"
    first_password=
    second_password=
    systemctl --user start "$service_name"

    if ! wait_until_ready; then
        echo "Password reset failed. Recent logs:" >&2
        journalctl --user -u "$service_name" -n 80 --no-pager >&2 || true
        exit 70
    fi
    echo "Web password changed."
}

show_status() {
    local http_code
    systemctl --user --no-pager --full status "$service_name" || true
    echo
    if podman container exists agent-web; then
        podman inspect \
            --format 'Container: {{.State.Status}} | Health: {{if .State.Health}}{{.State.Health.Status}}{{else}}n/a{{end}}' \
            agent-web
    else
        echo "Container: not present"
    fi
    http_code=$(curl -sk -o /dev/null -w '%{http_code}' https://127.0.0.1:6901/ || true)
    echo "HTTPS check: $http_code (401 means healthy and authentication is active)"
    echo "URL: $(access_url)"
}

usage() {
    cat <<'EOF'
Usage: agent-webctl COMMAND

Commands:
  status             Show service, container, and HTTPS health
  logs               Follow service logs
  start              Start Agent Web
  stop               Stop Agent Web (profile and cookies remain)
  restart            Restart Agent Web
  set-password       Replace the web login password
  renew-certificate  Generate a new private TLS certificate
  update             Pull the latest Git commit and rebuild
  url                Print the browser URL
EOF
}

command_name=${1:-status}
case "$command_name" in
    status)
        show_status
        ;;
    logs)
        exec journalctl --user -u "$service_name" -f
        ;;
    start)
        systemctl --user start "$service_name"
        echo "Agent Web started: $(access_url)"
        ;;
    stop)
        systemctl --user stop "$service_name"
        echo "Agent Web stopped. Browser data was preserved."
        ;;
    restart)
        systemctl --user restart "$service_name"
        echo "Agent Web restarted: $(access_url)"
        ;;
    set-password)
        set_password
        ;;
    renew-certificate)
        systemctl --user stop "$service_name"
        rm -f "$state_dir/tls.crt" "$state_dir/tls.key"
        systemctl --user start "$service_name"
        if ! wait_until_ready; then
            echo "Certificate renewal failed. Check: agent-webctl logs" >&2
            exit 70
        fi
        echo "Private TLS certificate renewed."
        ;;
    update)
        if [[ ! -d "${AGENT_WEB_SOURCE_DIR:-}/.git" ]]; then
            echo "The installed source is not a Git checkout: ${AGENT_WEB_SOURCE_DIR:-unset}" >&2
            exit 66
        fi
        git -C "$AGENT_WEB_SOURCE_DIR" pull --ff-only
        exec "$AGENT_WEB_SOURCE_DIR/podman-install.sh" --update
        ;;
    url)
        access_url
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        echo "Unknown command: $command_name" >&2
        usage >&2
        exit 64
        ;;
esac
